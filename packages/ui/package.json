{
  "name": "@kcclab/ui",
  "version": "0.0.1",
  "description": "kcclab design system - React components and design tokens",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kccinc/design-system.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2",
    "@radix-ui/react-checkbox": "^1.3",
    "@radix-ui/react-dialog": "^1.1",
    "@radix-ui/react-dropdown-menu": "^2.1",
    "@radix-ui/react-popover": "^1.1",
    "@radix-ui/react-progress": "^1.1",
    "@radix-ui/react-radio-group": "^1.4",
    "@radix-ui/react-select": "^2.3",
    "@radix-ui/react-switch": "^1.3",
    "@radix-ui/react-tabs": "^1.1",
    "@radix-ui/react-toast": "^1.2",
    "@radix-ui/react-tooltip": "^1.2",
    "date-fns": "^4.4",
    "react-day-picker": "^10.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  }
}
